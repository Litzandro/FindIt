# Crea un archivo frontend/.env con estos datos. No subas el archivo real a Git.
# Desde backend: npm run db:status
# Web en la misma PC: http://127.0.0.1:54321
# Expo Go en teléfono: http://IP_LAN_DE_TU_PC:54321 (reemplázala por ipconfig)
# Android emulator: http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Copia "anon key" (o publishable key si aparece) desde db:status.
# Nunca utilices service_role ni secret key en una app Expo.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REEMPLAZA_CON_LA_CLAVE_PUBLICA
